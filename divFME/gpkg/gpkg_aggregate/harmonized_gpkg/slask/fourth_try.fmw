DEFAULT_MACRO WB_CURRENT_CONTEXT
MACRO VariableSetter_VAR aVariable
INCLUDE [    if {{Global} == {Local}} {       puts {MACRO VariableSetter_VAR $(WB_CURRENT_CONTEXT)_aVariable};    };    proc stripEvaluateExpression {val} {       if [regexp {@EvaluateExpression\([^)]*STRING_ENCODED,([^,]*),.+\)} $val -> unwrapped] {          return $unwrapped       } else {          return $val       };    };    set strippedValue [stripEvaluateExpression {@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_iterations<closeparen>,VariableSetter)}];    puts "MACRO VariableSetter_VALUE $strippedValue"; ]
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { VariableSetter }    INPUT  FEATURE_TYPE Counter_2_OUTPUT    ATTR_ACTION { "" $(FME_UUID_SAFE) SET_TO "$(VariableSetter_VALUE)" }    OUTPUT { OUTPUT FEATURE_TYPE VariableSetter_OUTPUT        @GlobalVariable($(VariableSetter_VAR),fme_attribute_name,$(FME_UUID_SAFE))        @RemoveAttributes($(FME_UUID_SAFE))         }
