MULTI_READER_KEYWORD{0} CSV2_1
MULTI_READER_GEN_DIRECTIVES{0} FIELD_NAMES_LINE,1,SCAN_MAX_ROWS,10000,LIST_ATTR_MANGLE_SUPPORT,Yes,SCAN_TYPES,Yes,DELIMITER_DETECTION_ALGORITHM,EQUAL_FIELDS_PER_LINE,SUPPORTED_READER_ARCHIVE_EXTENSIONS,csv.gz<comma>txt.gz,REPLACE_ATTR_NAME_INVALID_CHARS,No,PRESERVE_SOURCE_ENCODING,No,TRIM_FIELD_NAME_QUALIFIERS,Yes,CHUNK_SIZE,100000,STRING_TYPE_ATTRIBUTE_HANDLING,EXPLICIT_WIDTH,TYPE_ATTRIBUTE_HANDLING,STANDARD_TYPES,SPATIAL_GROUP,,ENFORCE_STRICT_SCHEMA,No,READ_EMPTY_VALUES_AS,Null,X_ATTR,<lt>Unused<gt>,ENCODING_GROUP,FME_DISCLOSURE_OPEN,QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS,Yes,PREVIEW_PLACEHOLDER,,ADVANCED_GROUP,FME_DISCLOSURE_OPEN,SCHEMA,,TRIM_FIELD_VALUE_QUALIFIERS,Yes,DATA_START_LINE,2,EXPLICIT_GEOMETRY_ATTRIBUTES,Yes,FIELD_VALUES_GROUP,FME_DISCLOSURE_CLOSED,CSV2_EXPOSE_FORMAT_ATTRS,,DATE_INPUT_FORMAT,ISO,_MERGE_SCHEMAS,YES,SCHEMA_GENERATION_GROUP,FME_DISCLOSURE_CLOSED,FIELD_QUALIFIER_ESCAPE_CHARACTER,<lt>quote<gt>,DELIMITER,auto,CASE_SENSITIVE_FIELD_NAMES,Yes,SKIP_DUPLICATE_DELIMITERS,No,FIELD_NAMES_GROUP,FME_DISCLOSURE_CLOSED,TRIM_FIELD_NAME_WHITESPACE,Yes,SKIPPED_LINES_GROUP,FME_DISCLOSURE_CLOSED,SCAN_ADDITIONAL_FIELDS,No,FIELD_SEPARATION_GROUP,FME_DISCLOSURE_CLOSED,EXPOSE_ATTRS_GROUP,FME_DISCLOSURE_OPEN,BUILD_POINTS_GROUP,NO,READ_SKIPPED_LINES,No,DATASET_GROUP,FME_DISCLOSURE_OPEN,FIELD_QUALIFIER_CHARACTER,<lt>quote<gt>,Y_ATTR,<lt>Unused<gt>,ENCODING,utf-8,TRIM_FEATURE_TYPE_NAME,Yes,USE_CUSTOM_SCHEMA,NO,FIELDS_GROUP,FME_DISCLOSURE_OPEN,TRIM_FIELD_VALUE_WHITESPACE,No,FEATURE_TYPE_NAME,FORMAT_NAME,Z_ATTR,<lt>Unused<gt>,COORDINATE_SYSTEM,<lt>Unused<gt>
MULTI_READER_TYPE{1} JSON
MULTI_READER_KEYWORD{1} JSON_2
MULTI_READER_GEN_DIRECTIVES{1} SCAN_MODE,AUTO,GEOMETRY_FORMAT,None,SEARCH_ENVELOPE_MAXX,0,USE_SEARCH_ENVELOPE,NO,DECODE_TEXT_STRINGS,Yes,SEARCH_ENVELOPE_MAXY,0,JSON_EXPOSE_FORMAT_ATTRS,,GEOMETRY_KEY,<lt>Unused<gt>,SEARCH_ENVELOPE_MINX,0,COORDINATE_SYSTEM_KEY,<lt>Unused<gt>,_MERGE_SCHEMAS,YES,QUERY_TABLE,<lt>Unused<gt>,FLATTEN_MODE,ALL_LEVELS,CLIP_TO_ENVELOPE,NO,FEATURE_TYPE_KEY,json_featuretype,SEARCH_ENVELOPE_MINY,0,USE_BASENAME_AS_DEFAULT_FEATURE_TYPE,No,EXPOSE_ATTRS_GROUP,,SEARCH_ENVELOPE_COORDINATE_SYSTEM,,SAVE_FRAGMENTS,NO
