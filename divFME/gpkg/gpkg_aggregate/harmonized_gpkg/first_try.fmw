DEFAULT_MACRO CSV2_IN_BUILD_POINTS_GROUP_CSV2_1 NO
CSV2_1_BUILD_POINTS_GROUP "$(CSV2_IN_BUILD_POINTS_GROUP_CSV2_1)"
DEFAULT_MACRO CSV2_IN_X_ATTR_CSV2_1 <Unused>
CSV2_1_X_ATTR "$(CSV2_IN_X_ATTR_CSV2_1)"
DEFAULT_MACRO CSV2_IN_Y_ATTR_CSV2_1 <Unused>
CSV2_1_Y_ATTR "$(CSV2_IN_Y_ATTR_CSV2_1)"
DEFAULT_MACRO CSV2_IN_Z_ATTR_CSV2_1 <Unused>
CSV2_1_Z_ATTR "$(CSV2_IN_Z_ATTR_CSV2_1)"
