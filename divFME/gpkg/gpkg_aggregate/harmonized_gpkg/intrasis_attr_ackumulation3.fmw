FACTORY_DEF * TeeFactory   FACTORY_NAME "Tester_3 PASSED Splitter"   INPUT FEATURE_TYPE Tester_3_PASSED   OUTPUT FEATURE_TYPE Tester_3_PASSED_0_1zCUwpmZqCU=   OUTPUT FEATURE_TYPE Tester_3_PASSED_1_gArpYEgdbSM=
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO AttributeRemover_LIST_FUNC }    } else {        puts "MACRO AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { AttributeRemover }    INPUT  FEATURE_TYPE grunddata.attributes_POSTGRES_2    INPUT  FEATURE_TYPE grunddata2.attributes_POSTGRES_2    OUTPUT { FEATURE_TYPE AttributeRemover_OUTPUT        @RemoveAttributes(fme_encoded,class)        $(AttributeRemover_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester }    INPUT  FEATURE_TYPE AttributeRemover_OUTPUT    TEST { attribute_value ATTRIBUTE_HAS_A_VALUE "" ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE Tester_PASSED         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "Tester PASSED Splitter"   INPUT FEATURE_TYPE Tester_PASSED   OUTPUT FEATURE_TYPE Tester_PASSED_0_5lBjEqsEkCM=   OUTPUT FEATURE_TYPE Tester_PASSED_1_KD0nCAPnWg0=   OUTPUT FEATURE_TYPE Tester_PASSED_2_44sq16+2uWA=   OUTPUT FEATURE_TYPE Tester_PASSED_3_AnLVj6N0pXs=   OUTPUT FEATURE_TYPE Tester_PASSED_4_2Qt+Zh+Yua0=   OUTPUT FEATURE_TYPE Tester_PASSED_5_wPF7qCvt80k=   OUTPUT FEATURE_TYPE Tester_PASSED_6_u42o/4lvsG0=   OUTPUT FEATURE_TYPE Tester_PASSED_7_NE2Xz78tLqQ=
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttributeKeeperFactory    FACTORY_NAME { AttributeKeeper }    INPUT  FEATURE_TYPE Tester_PASSED_1_KD0nCAPnWg0=    KEEP_ATTRS { attribute_label,attribute_unit,class,data_type }    KEEP_LISTS {  }    KEEP_FME_ATTRIBUTES Yes    BUILD_FEATURE_TABLES { NO }    OUTPUT_ON_ATTRIBUTE_CHANGE { <Unused> }    OUTPUT { OUTPUT FEATURE_TYPE AttributeKeeper_OUTPUT        }
