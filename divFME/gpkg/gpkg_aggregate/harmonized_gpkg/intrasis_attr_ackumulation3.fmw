FACTORY_DEF {*} TestFactory FACTORY_NAME { TestFilter } INPUT FEATURE_TYPE TestFilter_INPUTLINE PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>attribute_label<closeparen>,TestFilter) CONTAINS l<u00e4>ngd ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_0 FEATURE_TYPE TestFilter_<at>Value<openparen>attribute_label<closeparen><space>CONTAINS<space>l<u00e4>ngd TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>attribute_label<closeparen>,TestFilter) CONTAINS bredd ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_1 FEATURE_TYPE TestFilter_<at>Value<openparen>attribute_label<closeparen><space>CONTAINS<space>bredd TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>attribute_label<closeparen>,TestFilter) CONTAINS djup ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_2 FEATURE_TYPE TestFilter_<at>Value<openparen>attribute_label<closeparen><space>=<space>djup TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>attribute_label<closeparen>,TestFilter) CONTAINS kommentar ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>attribute_label<closeparen>,TestFilter) CONTAINS anm<u00e4>rkning ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1 OR 2" OUTPUT PASSED_3 FEATURE_TYPE TestFilter_<at>Value<openparen>attribute_label<closeparen><space>CONTAINS<space>kommentar TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>attribute_label<closeparen>,TestFilter) CONTAINS beskrivning ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>attribute_label<closeparen>,TestFilter) CONTAINS besk ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1 OR 2" OUTPUT PASSED_4 FEATURE_TYPE TestFilter_<at>Value<openparen>attribute_label<closeparen><space>CONTAINS<space>beskrivning OUTPUT FAILED FEATURE_TYPE TestFilter_<lt>UNFILTERED<gt>
