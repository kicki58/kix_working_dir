#! START_DEST_HEADER CSV2 CSV2_2
# =====================================================================
# The following GUI line prompts for a folder where the
# CSV files will be stored
#! END_DEST_HEADER
#! START_WB_HEADER
DEFAULT_MACRO DestDataset
INCLUDE [ if {"$(DestDataset)" != ""} {                          \
 puts {DEFAULT_MACRO DestDataset_CSV2_2 $(DestDataset)}         \
 } ]
#! END_WB_HEADER
#! START_DEST_HEADER CSV2 CSV2_2
DEFAULT_MACRO DestDataset_CSV2_2 $(DestDataset_CSV2)
GUI DIRNAME DestDataset_CSV2_2 Destination CSV (Comma Separated Value) Folder:
DEFAULT_MACRO CSV2_OUT_DATASET_GROUP_CSV2_2 
GUI OPTIONAL DISCLOSUREGROUP CSV2_OUT_DATASET_GROUP_CSV2_2 CSV2_OUT_EXTENSION_CSV2_2%CSV2_OUT_EXISTING_FILE_HANDLING Dataset
DEFAULT_MACRO CSV2_OUT_EXTENSION_CSV2_2 csv
CSV2_2_EXTENSION "$(CSV2_OUT_EXTENSION_CSV2_2)"
GUI OPTIONAL TEXT CSV2_OUT_EXTENSION_CSV2_2 Extension:
DEFAULT_MACRO CSV2_OUT_EXISTING_FILE_HANDLING_CSV2_2 Yes
CSV2_2_EXISTING_FILE_HANDLING "$(CSV2_OUT_EXISTING_FILE_HANDLING_CSV2_2)"
DEFAULT_MACRO CSV2_OUT_FIELDS_GROUP_CSV2_2 
GUI OPTIONAL DISCLOSUREGROUP CSV2_OUT_FIELDS_GROUP_CSV2_2 CSV2_OUT_DELIMITER_CSV2_2%CSV2_OUT_WRITE_FIELD_NAMES Fields
DEFAULT_MACRO CSV2_OUT_DELIMITER_CSV2_2 <comma>
CSV2_2_DELIMITER "$(CSV2_OUT_DELIMITER_CSV2_2)"
GUI STRING_OR_CHOICE_ENCODED CSV2_OUT_DELIMITER_CSV2_2 ,%;%|%space%tab Delimiter Character:
DEFAULT_MACRO CSV2_OUT_WRITE_FIELD_NAMES_CSV2_2 firstrow
CSV2_2_WRITE_FIELD_NAMES "$(CSV2_OUT_WRITE_FIELD_NAMES_CSV2_2)"
DEFAULT_MACRO CSV2_OUT_ENCODING_GROUP_CSV2_2 
GUI OPTIONAL DISCLOSUREGROUP CSV2_OUT_ENCODING_GROUP_CSV2_2 CSV2_OUT_ENCODING_CSV2_2%CSV2_OUT_WRITE_BOM_FOR_UNICODE_CSV2_2 Encoding
DEFAULT_MACRO CSV2_OUT_ENCODING_CSV2_2 UTF-8
CSV2_2_ENCODING "$(CSV2_OUT_ENCODING_CSV2_2)"
GUI STRING_OR_ENCODING CSV2_OUT_ENCODING_CSV2_2 fme-system%* Character Encoding:
DEFAULT_MACRO CSV2_OUT_WRITE_BOM_FOR_UNICODE_CSV2_2 Yes
CSV2_2_WRITE_BOM_FOR_UNICODE "$(CSV2_OUT_WRITE_BOM_FOR_UNICODE_CSV2_2)"
GUI CHOICE CSV2_OUT_WRITE_BOM_FOR_UNICODE_CSV2_2 Yes%No Write Byte Order Mark for Unicode:
DEFAULT_MACRO CSV2_OUT_SPATIAL_GROUP_CSV2_2 
GUI OPTIONAL DISCLOSUREGROUP CSV2_OUT_SPATIAL_GROUP_CSV2_2 CSV2_OUT_COORDINATE_FIELDS_FROM_GEOM_GROUP_CSV2_2 Spatial
DEFAULT_MACRO CSV2_OUT_COORDINATE_FIELDS_FROM_GEOM_GROUP_CSV2_2 YES
CSV2_2_COORDINATE_FIELDS_FROM_GEOM_GROUP "$(CSV2_OUT_COORDINATE_FIELDS_FROM_GEOM_GROUP_CSV2_2)"
GUI ACTIVEDISCLOSUREGROUP CSV2_OUT_COORDINATE_FIELDS_FROM_GEOM_GROUP_CSV2_2 CSV2_OUT_COORDINATE_SYSTEM_CSV2_2%CSV2_OUT_COORDINATE_DETECTION_MODE_CSV2_2%CSV2_OUT_X_FIELD_NAME_CSV2_2%CSV2_OUT_Y_FIELD_NAME_CSV2_2%CSV2_OUT_Z_FIELD_NAME_CSV2_2 Populate Coordinate Fields From Point Geometry
DEFAULT_MACRO CSV2_OUT_COORDINATE_SYSTEM_CSV2_2 
CSV2_2_COORDINATE_SYSTEM "$(CSV2_OUT_COORDINATE_SYSTEM_CSV2_2)"
GUI OPTIONAL COORDSYS CSV2_OUT_COORDINATE_SYSTEM_CSV2_2 Coordinate System:
DEFAULT_MACRO CSV2_OUT_COORDINATE_DETECTION_MODE_CSV2_2 automatic
CSV2_2_COORDINATE_DETECTION_MODE "$(CSV2_OUT_COORDINATE_DETECTION_MODE_CSV2_2)"
GUI ACTIVECHOICE_LOOKUP CSV2_OUT_COORDINATE_DETECTION_MODE_CSV2_2 Automatic,automatic,CSV2_OUT_X_FIELD_NAME_CSV2_2,CSV2_OUT_Y_FIELD_NAME_CSV2_2,CSV2_OUT_Z_FIELD_NAME_CSV2_2%Manual,manual Coordinate Field Detection
DEFAULT_MACRO CSV2_OUT_X_FIELD_NAME_CSV2_2 <Unused>
CSV2_2_X_FIELD_NAME "$(CSV2_OUT_X_FIELD_NAME_CSV2_2)"
GUI ATTR_ENCODED CSV2_OUT_X_FIELD_NAME_CSV2_2 INCLUDE_DEST_USER X Coordinate Field:
DEFAULT_MACRO CSV2_OUT_Y_FIELD_NAME_CSV2_2 <Unused>
CSV2_2_Y_FIELD_NAME "$(CSV2_OUT_Y_FIELD_NAME_CSV2_2)"
GUI ATTR_ENCODED CSV2_OUT_Y_FIELD_NAME_CSV2_2 INCLUDE_DEST_USER Y Coordinate Field:
DEFAULT_MACRO CSV2_OUT_Z_FIELD_NAME_CSV2_2 
GUI OPTIONAL ATTR_ENCODED CSV2_OUT_Z_FIELD_NAME_CSV2_2 INCLUDE_DEST_USER Z Coordinate Field:
DEFAULT_MACRO CSV2_OUT_ADVANCED_GROUP_CSV2_2 
GUI OPTIONAL DISCLOSUREGROUP CSV2_OUT_ADVANCED_GROUP_CSV2_2 FME_DISCLOSURE_CLOSED%CSV2_OUT_QUALIFY_FIELD_NAMES_CSV2_2%CSV2_OUT_QUALIFY_FIELD_VALUES_CSV2_2%CSV2_OUT_UNQUALIFIED_FIELD_VALUE_HANDLING_CSV2_2%CSV2_OUT_TREAT_EMBEDDED_FIELD_QUALIFIERS_AS_UNSAFE_CSV2_2%CSV2_OUT_INJECTION_ESCAPE_CSV2_2%CSV2_OUT_FIELD_QUALIFIER_CHARACTER_CSV2_2%CSV2_OUT_FIELD_QUALIFIER_ESCAPE_CHARACTER_CSV2_2%CSV2_OUT_ROW_TERMINATION_CSV2_2%CSV2_OUT_WRITE_SCHEMA_FILE_CSV2_2 Advanced
DEFAULT_MACRO CSV2_OUT_QUALIFY_FIELD_NAMES_CSV2_2 if_needed
CSV2_2_QUALIFY_FIELD_NAMES "$(CSV2_OUT_QUALIFY_FIELD_NAMES_CSV2_2)"
GUI LOOKUP_CHOICE CSV2_OUT_QUALIFY_FIELD_NAMES_CSV2_2 Yes,yes%No,no%If<space>Needed,if_needed Qualify Field Names:
DEFAULT_MACRO CSV2_OUT_QUALIFY_FIELD_VALUES_CSV2_2 if_needed
CSV2_2_QUALIFY_FIELD_VALUES "$(CSV2_OUT_QUALIFY_FIELD_VALUES_CSV2_2)"
GUI ACTIVECHOICE_LOOKUP CSV2_OUT_QUALIFY_FIELD_VALUES_CSV2_2 Yes,yes,CSV2_OUT_UNQUALIFIED_FIELD_VALUE_HANDLING_CSV2_2%No,no%If<space>Needed,if_needed,CSV2_OUT_UNQUALIFIED_FIELD_VALUE_HANDLING_CSV2_2 Qualify Field Values:
DEFAULT_MACRO CSV2_OUT_UNQUALIFIED_FIELD_VALUE_HANDLING_CSV2_2 <Unused>
CSV2_2_UNQUALIFIED_FIELD_VALUE_HANDLING "$(CSV2_OUT_UNQUALIFIED_FIELD_VALUE_HANDLING_CSV2_2)"
GUI LOOKUP_CHOICE CSV2_OUT_UNQUALIFIED_FIELD_VALUE_HANDLING_CSV2_2 Remove<space>Unsafe<space>Characters,remove_unsafe%Preserve<space>Unsafe<space>Characters,preserve_unsafe Unqualified Field Value Handling:
DEFAULT_MACRO CSV2_OUT_TREAT_EMBEDDED_FIELD_QUALIFIERS_AS_UNSAFE_CSV2_2 Yes
CSV2_2_TREAT_EMBEDDED_FIELD_QUALIFIERS_AS_UNSAFE "$(CSV2_OUT_TREAT_EMBEDDED_FIELD_QUALIFIERS_AS_UNSAFE_CSV2_2)"
GUI CHOICE CSV2_OUT_TREAT_EMBEDDED_FIELD_QUALIFIERS_AS_UNSAFE_CSV2_2 Yes%No Treat Embedded Field Qualifiers As Unsafe:
DEFAULT_MACRO CSV2_OUT_INJECTION_ESCAPE_CSV2_2 no
CSV2_2_INJECTION_ESCAPE "$(CSV2_OUT_INJECTION_ESCAPE_CSV2_2)"
GUI LOOKUP_CHOICE CSV2_OUT_INJECTION_ESCAPE_CSV2_2 Yes,yes%No,no Prevent Formula Injection:
DEFAULT_MACRO CSV2_OUT_FIELD_QUALIFIER_CHARACTER_CSV2_2 <quote>
CSV2_2_FIELD_QUALIFIER_CHARACTER "$(CSV2_OUT_FIELD_QUALIFIER_CHARACTER_CSV2_2)"
GUI STRING_ENCODED CSV2_OUT_FIELD_QUALIFIER_CHARACTER_CSV2_2 Field Qualifier Character:
DEFAULT_MACRO CSV2_OUT_FIELD_QUALIFIER_ESCAPE_CHARACTER_CSV2_2 <quote>
CSV2_2_FIELD_QUALIFIER_ESCAPE_CHARACTER "$(CSV2_OUT_FIELD_QUALIFIER_ESCAPE_CHARACTER_CSV2_2)"
GUI STRING_ENCODED CSV2_OUT_FIELD_QUALIFIER_ESCAPE_CHARACTER_CSV2_2 Field Qualifier Escape Character:
DEFAULT_MACRO CSV2_OUT_ROW_TERMINATION_CSV2_2 System
CSV2_2_ROW_TERMINATION "$(CSV2_OUT_ROW_TERMINATION_CSV2_2)"
GUI CHOICE CSV2_OUT_ROW_TERMINATION_CSV2_2 System%Windows%Unix%Macintosh Row Termination:
DEFAULT_MACRO CSV2_OUT_WRITE_SCHEMA_FILE_CSV2_2 NO
CSV2_2_WRITE_SCHEMA_FILE "$(CSV2_OUT_WRITE_SCHEMA_FILE_CSV2_2)"
GUI ACTIVEDISCLOSUREGROUP CSV2_OUT_WRITE_SCHEMA_FILE_CSV2_2 FME_DISCLOSURE_CLOSED%CSV2_OUT_EXISTING_SCHEMA_FILE_HANDLING_CSV2_2 Write Schema Configuration File
DEFAULT_MACRO CSV2_OUT_EXISTING_SCHEMA_FILE_HANDLING_CSV2_2 <Unused>
CSV2_2_EXISTING_SCHEMA_FILE_HANDLING "$(CSV2_OUT_EXISTING_SCHEMA_FILE_HANDLING_CSV2_2)"
GUI CHOICE CSV2_OUT_EXISTING_SCHEMA_FILE_HANDLING_CSV2_2 Overwrite%Prepend Existing Schema File Handling:
DEFAULT_MACRO CSV2_OUT_COORDINATE_SYSTEM_GRANULARITY_CSV2_2 FEATURE_TYPE
CSV2_2_COORDINATE_SYSTEM_GRANULARITY "$(CSV2_OUT_COORDINATE_SYSTEM_GRANULARITY_CSV2_2)"
DEFAULT_MACRO CSV2_OUT_FORMAT_NUMBERS_WITH_WIDTH_PRECISION_CSV2_2 Yes
CSV2_2_FORMAT_NUMBERS_WITH_WIDTH_PRECISION "$(CSV2_OUT_FORMAT_NUMBERS_WITH_WIDTH_PRECISION_CSV2_2)"
