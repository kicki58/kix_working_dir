FACTORY_DEF {*} WorkspaceRunnerFactory    FACTORY_NAME { WorkspaceRunner }    BLOCKING { Yes }    OVERWRITE_LOG_FILE { HONOR }    STDERR_HANDLING { COMBINE }    MAX_PROC { <Unused> }    MAX_TO_BATCH { <Unused> }    LAST_KNOWN_PARAM_DEFS {  }    INPUT  FEATURE_TYPE AttributeManager_OUTPUT    WORKSPACE_FILE { @EvaluateExpression(FDIV,STRING_ENCODED,$(FME_MF_DIR_ENCODED)aggregate.fmw,WorkspaceRunner) }    WORKSPACE_PARAMETER { SourceDataset_OGCGEOPACKAGE @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>path_windows<closeparen>,WorkspaceRunner) } WORKSPACE_PARAMETER { DestDataset_OGCGEOPACKAGE @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>aggregated_gpkg<closeparen>,WorkspaceRunner) }
