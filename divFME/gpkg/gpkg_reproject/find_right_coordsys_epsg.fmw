# -------------------------------------------------------------------------

FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   MULTI_READER_KEYWORD $(DATASET_KEYWORD_OGCGEOPACKAGE_1)   INPUT FEATURE_TYPE *    ROUTE OGCGEOPACKAGE OGCGEOPACKAGE_1::features multi_reader_keyword,$(DATASET_KEYWORD_OGCGEOPACKAGE_1) TO FME_GENERIC ::features ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
OGCGEOPACKAGE_1_MERGE_DEF OGCGEOPACKAGE_1::features EXACT features DEFLINE geopackage_type,geopackage_none,geopackage_where_clause,,fme_attribute_reading,defined,geom,text,object_id,mediumint,SymbolId,mediumint,GeoObjectId,mediumint,spatial_type,text,fid,int<comma>PrimaryKey
OGCGEOPACKAGE_1_MERGE_DEF OGCGEOPACKAGE_1::project_information EXACT project_information
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "features_OGCGEOPACKAGE_1 Splitter"    INPUT FEATURE_TYPE features    OUTPUT FEATURE_TYPE features_OGCGEOPACKAGE_1
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "project_information_OGCGEOPACKAGE_1 Splitter"    INPUT FEATURE_TYPE project_information    OUTPUT FEATURE_TYPE project_information_OGCGEOPACKAGE_1
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
Tcl2 proc CoordinateSystemRemover_CoordSysRemover {} {   global FME_CoordSys;   set FME_CoordSys {}; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { CoordinateSystemRemover }    INPUT  FEATURE_TYPE features_OGCGEOPACKAGE_1    INPUT  FEATURE_TYPE project_information_OGCGEOPACKAGE_1    OUTPUT { FEATURE_TYPE CoordinateSystemRemover_OUTPUT         @Tcl2(CoordinateSystemRemover_CoordSysRemover)          }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO AttributeRemover_LIST_FUNC }    } else {        puts "MACRO AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { AttributeRemover }    INPUT  FEATURE_TYPE CoordinateSystemRemover_OUTPUT    OUTPUT { FEATURE_TYPE AttributeRemover_OUTPUT        @RemoveAttributes(fme_encoded,geom)        $(AttributeRemover_LIST_FUNC)         }
# -------------------------------------------------------------------------
INCLUDE [    if { {CARTESIAN} == {CARTESIAN} } {       puts {MACRO Offsetter_OFFSET @Offset(REJECTABLE,"@EvaluateExpression(FDIV,FLOAT,$(XOFF$encode),Offsetter)","@EvaluateExpression(FDIV,FLOAT,$(YOFF$encode),Offsetter)","0")};    } elseif { {CARTESIAN} == {POLAR} } {       puts {MACRO Offsetter_OFFSET @Offset(REJECTABLE,"CARTESIAN","<Unused>","<Unused>")};    } elseif { {CARTESIAN} == {SPHERICAL} } {       puts {MACRO Offsetter_OFFSET @Offset(REJECTABLE,"CARTESIAN","<Unused>","<Unused>","<Unused>")};    } else {       puts {MACRO Offsetter_OFFSET @Offset(REJECTABLE,"@EvaluateExpression(FDIV,FLOAT,$(XOFF$encode),Offsetter)","@EvaluateExpression(FDIV,FLOAT,$(YOFF$encode),Offsetter)","0")};    } ]
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { Offsetter_Offsetter }    INPUT  FEATURE_TYPE AttributeRemover_OUTPUT    FUNCTION_DEFINITION { $(Offsetter_OFFSET) }    OUTPUT { COMPLETE FEATURE_TYPE Offsetter_Offset }    OUTPUT { REJECTED FEATURE_TYPE Offsetter_<REJECTED>        }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Offsetter_PointCloudOffsetter }    INPUT { FEATURE_TYPE Offsetter_Offset }    TEST &fme_type == "fme_point_cloud"    TEST { "" != "" }    BOOLEAN_OPERATOR AND    OUTPUT { PASSED FEATURE_TYPE Offsetter_OFFSET       @TransformPointCloud(OFFSET,)        }    OUTPUT { FAILED FEATURE_TYPE Offsetter_OFFSET        }
FACTORY_DEF * TeeFactory   FACTORY_NAME "Offsetter OFFSET Splitter"   INPUT FEATURE_TYPE Offsetter_OFFSET   OUTPUT FEATURE_TYPE Offsetter_OFFSET_0_Gz/9zAA7Q7Q=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_1_/ITRo8ntPG8=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_2_CpEJRRdbL1I=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_3_XolffEg5ku0=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_4_mjWwZFwSAYw=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_5_Ice006Qr9yI=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_6_HYapbJuQ0qg=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_7_ClBjd3G1wbE=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_8_u2tVxYzu0vU=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_9_OTSvm902Q70=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_10_S6P4S7Slvvo=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_11_eTPgLu7Wi6U=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_12_MSVWZugXVww=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_13_iP3D67toPZs=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_14_jOO1Pa2jLCM=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_15_445SoLUDtX4=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_16_t63oE6PxS0k=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_17_BNgjjyPUKKI=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_18_grYrBVPyX1Q=   OUTPUT FEATURE_TYPE Offsetter_OFFSET_19_p5i6finSyNs=
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME Offsetter_<Rejected> INPUT FEATURE_TYPE Offsetter_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, Offsetter<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
