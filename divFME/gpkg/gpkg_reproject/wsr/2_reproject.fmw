# -------------------------------------------------------------------------

OGCGEOPACKAGE_5_READER_META_ATTRIBUTES fme_feature_type

# -------------------------------------------------------------------------

MULTI_READER_CONTINUE_ON_READER_FAILURE No

# -------------------------------------------------------------------------

MACRO FME_VIEWER_APP fmedatainspector
# -------------------------------------------------------------------------

FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   INPUT FEATURE_TYPE *    ROUTE OGCGEOPACKAGE OGCGEOPACKAGE_2::features multi_reader_keyword,$(DATASET_KEYWORD_OGCGEOPACKAGE_2) TO FME_GENERIC ::features ALIAS_GEOMETRY    ROUTE OGCGEOPACKAGE OGCGEOPACKAGE_5::project_information multi_reader_keyword,$(DATASET_KEYWORD_OGCGEOPACKAGE_5) TO FME_GENERIC ::project_information ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
OGCGEOPACKAGE_2_MERGE_DEF OGCGEOPACKAGE_2::features EXACT features DEFLINE geopackage_type,geopackage_none,geopackage_where_clause,,fme_attribute_reading,defined,geom,text,object_id,mediumint,SymbolId,mediumint,GeoObjectId,mediumint,spatial_type,text,fid,int<comma>PrimaryKey
