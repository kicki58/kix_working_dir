# -------------------------------------------------------------------------
SHAPEFILE_1_DEF socknar_sverige   shapefile_type               shapefile_polygon   SNID_1                       varchar(16)   SNID_2                       varchar(16)   SNID_3                       varchar(16)   SNID_4                       number(16,0)   NAMN                         varchar(254)   LAN                          varchar(254)   NOT                          varchar(50)   KOMMENTAR                    varchar(254)   DATUM                        varchar(16)   VERSION                      varchar(16)   KALLA                        varchar(25)   AREA                         double   PERIMETER                    double   HECTARES                     double
# -------------------------------------------------------------------------

FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   INPUT FEATURE_TYPE *    ROUTE SHAPEFILE SHAPEFILE_1::socknar_sverige multi_reader_keyword,$(DATASET_KEYWORD_SHAPEFILE_1) TO FME_GENERIC ::socknar_sverige ALIAS_GEOMETRY    ROUTE PATH PATH_1::PATH multi_reader_keyword,$(DATASET_KEYWORD_PATH_1) TO FME_GENERIC ::PATH ALIAS_GEOMETRY    ROUTE OGCGEOPACKAGE OGCGEOPACKAGE_1::lan multi_reader_keyword,$(DATASET_KEYWORD_OGCGEOPACKAGE_1) TO FME_GENERIC ::lan ALIAS_GEOMETRY    ROUTE OGCGEOPACKAGE OGCGEOPACKAGE_1::kommun multi_reader_keyword,$(DATASET_KEYWORD_OGCGEOPACKAGE_1) TO FME_GENERIC ::kommun ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
SHAPEFILE_1_MERGE_DEF SHAPEFILE_1::socknar_sverige EXACT socknar_sverige
OGCGEOPACKAGE_3_MERGE_DEF OGCGEOPACKAGE_3::lan EXACT lan
OGCGEOPACKAGE_3_MERGE_DEF OGCGEOPACKAGE_3::kommun EXACT kommun
OGCGEOPACKAGE_3_MERGE_DEF OGCGEOPACKAGE_3::rike EXACT rike
PATH_1_MERGE_DEF PATH_1::PATH EXACT PATH
OGCGEOPACKAGE_4_MERGE_DEF OGCGEOPACKAGE_4::arkeologiska_uppdrag_undersökningsområden_sverige_polygon EXACT arkeologiska_uppdrag_unders<u00f6>kningsomr<u00e5>den_sverige_polygon
OGCGEOPACKAGE_4_MERGE_DEF OGCGEOPACKAGE_4::arkeologiska_uppdrag_undersökningsområden_sverige_point EXACT arkeologiska_uppdrag_unders<u00f6>kningsomr<u00e5>den_sverige_point
