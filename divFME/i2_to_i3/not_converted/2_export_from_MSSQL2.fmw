MACRO FeatureReader_OUTPUT_PORTS_ENCODED ILine IMultiP IPoint IPolygon LLine LMultiP LPoint LPolygon Line MultiP Point Polygon
MACRO FeatureReader_DIRECTIVES ADVANCED,,ALLOW_MISMATCHED_SHZ_BASENAME,No,COORDINATE_SYSTEM,,DONUT_DETECTION,ORIENTATION,ENCODING,fme-source-encoding,EXPOSE_ATTRS_GROUP,,MEASURES_AS_Z,No,NETWORK_AUTHENTICATION,,NUMERIC_TYPE_ATTRIBUTE_HANDLING,STANDARD_TYPES,READ_BLANK_AS,MISSING,READ_NUMERIC_PADDING_AS,ZERO,REPORT_BAD_GEOMETRY,No,SET_GEOMETRY_LABEL,NO,SHAPEFILE_EXPOSE_FORMAT_ATTRS,,SPATIAL_GROUP,,TRIM_PRECEDING_SPACES,Yes,USE_SEARCH_ENVELOPE,NO,USE_STRING_FOR_NUMERIC_STORAGE,No
# Always provide an INTERACTION, otherwise the factory defaults to ENVELOPE_INTERSECTS
INCLUDE [if { ( {NONE} == {<Unused>} ) || ( {($INTERACT)} == {} ) } {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION NONE};          } else {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION "NONE"};          }         ]
# Consolidate the attribute merge options to what the factory expects
DEFAULT_MACRO FeatureReader_COMBINE_ATTRS
INCLUDE [       if { {RESULT_ONLY} == {MERGE} } {          puts "MACRO FeatureReader_COMBINE_ATTRS <Unused>";       } else {          puts "MACRO FeatureReader_COMBINE_ATTRS RESULT_ONLY";       };    ]
INCLUDE [    puts {DEFAULT_MACRO FeatureReaderDataset_FeatureReader @EvaluateExpression(FDIV,STRING_ENCODED,$(file2shp$encode)<backslash>*.shp,FeatureReader)}; ]
FACTORY_DEF {CONNECTED} CreationFactory    FACTORY_NAME { FeatureReader_Creator }    OUTPUT { FEATURE_TYPE FeatureReader_____CREATED______ }
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { FeatureReader }    INPUT { FEATURE_TYPE FeatureReader_____CREATED______ }    INPUT INITIATOR FEATURE_TYPE Creator_CREATED    $(FCTQUERY_INTERACTION_LINE)    CLIP_TO_INITIATOR_ENVELOPE { "NO" }    COMBINE_ATTRIBUTES  { $(FeatureReader_COMBINE_ATTRS) }    IGNORE_NULLS        { <Unused> }    REJECT_POINTS       { YES }    QUERYFCT_ATTRIBUTE_PREFIX { <Unused> }    COMBINE_GEOMETRY    { RESULT_ONLY }    ENABLE_CACHE        { NO }    QUERYFCT_TABLE_SEPARATOR { SPACE }    READER_TYPE         { SHAPEFILE  }    READER_DATASET      { "$(FeatureReaderDataset_FeatureReader)" }    QUERYFCT_IDS        { "" }    QUERYFCT_IDS_FORMAT WWJD_PARTS    READER_DIRECTIVES   { METAFILE,SHAPEFILE }    QUERYFCT_OUTPUT     { "BASED_ON_CONNECTIONS" }    QUERYFCT_ADD_SCHEMA { "NO" }    QUERYFCT_USE_SCHEMA_CACHE { "YES" }    QUERYFCT_INITIATOR_FIRST_OUTPUT { "default" }    QUERYFCT_DEDUPE_GEOM YES    CONTINUE_ON_READER_ERROR YES    ORDER_RESULTS { "No" }    QUERYFCT_RESULT_TAGS { $(FeatureReader_OUTPUT_PORTS_ENCODED) }    QUERYFCT_SET_FME_FEATURE_TYPE YES    QUERYFCT_SET_FME_META_ATTRS YES    READER_PARAMS_WWJD     { $(FeatureReader_DIRECTIVES) }    TREAT_READER_PARAM_AMPERSANDS_AS_LITERALS YES    HONOR_INITIATOR_COORDSYS YES    OUTPUT { SCHEMA FEATURE_TYPE FeatureReader_<SCHEMA>           }    OUTPUT ILine FEATURE_TYPE FeatureReader_ILine    OUTPUT IMultiP FEATURE_TYPE FeatureReader_IMultiP    OUTPUT IPoint FEATURE_TYPE FeatureReader_IPoint    OUTPUT IPolygon FEATURE_TYPE FeatureReader_IPolygon    OUTPUT LLine FEATURE_TYPE FeatureReader_LLine    OUTPUT LMultiP FEATURE_TYPE FeatureReader_LMultiP    OUTPUT LPoint FEATURE_TYPE FeatureReader_LPoint    OUTPUT LPolygon FEATURE_TYPE FeatureReader_LPolygon    OUTPUT Line FEATURE_TYPE FeatureReader_Line    OUTPUT MultiP FEATURE_TYPE FeatureReader_MultiP    OUTPUT Point FEATURE_TYPE FeatureReader_Point    OUTPUT Polygon FEATURE_TYPE FeatureReader_Polygon
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester_2 }    INPUT  FEATURE_TYPE FeatureReader_<SCHEMA>    INPUT  FEATURE_TYPE FeatureReader_ILine    INPUT  FEATURE_TYPE FeatureReader_IMultiP    INPUT  FEATURE_TYPE FeatureReader_IPoint    INPUT  FEATURE_TYPE FeatureReader_IPolygon    INPUT  FEATURE_TYPE FeatureReader_LLine    INPUT  FEATURE_TYPE FeatureReader_LMultiP    INPUT  FEATURE_TYPE FeatureReader_LPoint    INPUT  FEATURE_TYPE FeatureReader_LPolygon    INPUT  FEATURE_TYPE FeatureReader_Line    INPUT  FEATURE_TYPE FeatureReader_MultiP    INPUT  FEATURE_TYPE FeatureReader_Point    INPUT  FEATURE_TYPE FeatureReader_Polygon    TEST { 1 = 1 ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE Tester_2_PASSED         }
