XLSXR_1_MERGE_DEF XLSXR_1::leverans EXACT leverans DEFLINE xlsx_start_row,,xlsx_end_row,,xlsx_apply_filters,No,fme_attribute_reading,defined,Databasnamn,char<openparen>12<closeparen>,Leveransformat,char<openparen>19<closeparen>,Databas<space>utg<u00e5>r,char<openparen>2<closeparen>,Anledning-Databas<space>utg<u00e5>r,char<openparen>18<closeparen>,Kommentar<space>leverans,char<openparen>42<closeparen>,Uppdragsnummer,char<openparen>31<closeparen>,extrakoll,char<openparen>68<closeparen>,Lst<space>dnr,char<openparen>43<closeparen>,Internt<space>dnr,char<openparen>1<closeparen>,Uppgett<space>koordinatsystem,number<openparen>4<comma>0<closeparen>,Faktiskt<space>koordinatsystem,char<openparen>1<closeparen>,Sweref<space>klart,char<openparen>2<closeparen>,Koordinatsystem<solidus>geolokalisering<space>kommentar,char<openparen>1<closeparen>,Manuellt<space>rektifierad,char<openparen>1<closeparen>,L<u00e4>gesos<u00e4>kerhet,char<openparen>1<closeparen>,Rektifiering<space>kommentar,char<openparen>1<closeparen>,Sekretesskontroll<space>godk<u00e4>nd,char<openparen>1<closeparen>,S<u00e4>kerhetskontroll-metod,char<openparen>1<closeparen>,Klar<space>f<u00f6>r<space>AGES,char<openparen>3<closeparen>,Anledning<space>-<space>ej<space>publiceringsredo,char<openparen>21<closeparen>,Publicerad<space>p<u00e5><space>AGES,char<openparen>3<closeparen>,Datum<space>f<u00f6>r<space>publicering,char<openparen>1<closeparen>,Rapportl<u00e4>nk-<openparen>ej<space>hos<space>RA<u00c4><closeparen>,char<openparen>1<closeparen>,Titel,char<openparen>1<closeparen>,F<u00f6>rfattare,char<openparen>1<closeparen>,Utgivnings<u00e5>r,char<openparen>1<closeparen>
