# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {Logger_54008bf5_2eeb_4485_83d7_21acca4074330} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME Logger
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Logger_Logger }    INPUT  FEATURE_TYPE FeatureMerger_6_MERGED    OUTPUT { FEATURE_TYPE Logger_LOGGED                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Databasnamn<closeparen><space>finns<space>redan<space>i<space>AGES,Logger)","20","20","",INFO,LOG_ONLY,$(FME_UUID_SAFE))                   }
FACTORY_DEF * TeeFactory   FACTORY_NAME "Logger LOGGED Splitter"   INPUT FEATURE_TYPE Logger_LOGGED   OUTPUT FEATURE_TYPE Logger_LOGGED_0_tTOzkVRnjNA=   OUTPUT FEATURE_TYPE Logger_LOGGED_1_IS/0CSiTWA4=
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory   FACTORY_NAME "Terminator (Disabled) Nuker"   INPUT FEATURE_TYPE Logger_LOGGED_0_tTOzkVRnjNA=
# -------------------------------------------------------------------------
