# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {FeatureMerger_5_UnmergedRequestor_ae91b82a_fbd7_4b65_9816_73e999dfa8180} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME FeatureMerger_5_UnmergedRequestor
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { FeatureMerger_5_UnmergedRequestor_Logger }    INPUT  FEATURE_TYPE FeatureMerger_5_UNMERGED_REQUESTOR    OUTPUT { FEATURE_TYPE FeatureMerger_5_UnmergedRequestor_LOGGED                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>geopackage<closeparen>.gpkg<space>finns<space>inte<space>i<space>utpekade<space>foldern:<space>$(SourceDataset_PATH$encode),FeatureMerger_5_UnmergedRequestor)","20","20","",INFO,LOG_ONLY,$(FME_UUID_SAFE))                   }
# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {FeatureMerger_5_UnusedSupplier_017fa700_fc33_4051_95ba_b9b5622f9a3b0} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME FeatureMerger_5_UnusedSupplier
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { FeatureMerger_5_UnusedSupplier_Logger }    INPUT  FEATURE_TYPE FeatureMerger_5_UNUSED_SUPPLIER    OUTPUT { FEATURE_TYPE FeatureMerger_5_UnusedSupplier_LOGGED                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>gpkg_name<closeparen>.gpkg<space>finns<space>inte<space>i<space>excelfilen:<space>$(leverans$encode),FeatureMerger_5_UnusedSupplier)","20","20","",INFO,LOG_ONLY,$(FME_UUID_SAFE))                   }
