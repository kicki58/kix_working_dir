INCLUDE [    if { {CENTER} == {CENTER}  } {          puts {MACRO GENERATE_POINT @GeneratePoint(3D,_inside_x,_inside_y,_inside_z,CENTER)};    } else {       if { {CENTER} == {CENTEROFGRAV}  } {             puts {MACRO GENERATE_POINT @GeneratePoint(3D,_inside_x,_inside_y,_inside_z,CENTER_OF_GRAVITY)};       } else {             puts {MACRO GENERATE_POINT @GeneratePoint(3D,_inside_x,_inside_y,_inside_z)};       };    }; ]
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { CenterPointExtractor_Rejector }    INPUT  FEATURE_TYPE Aggregator_AGGREGATE    FUNCTION_DEFINITION { $(GENERATE_POINT) }    OUTPUT { COMPLETE FEATURE_TYPE CenterPointExtractor_OUTPUT        }    OUTPUT { REJECTED FEATURE_TYPE CenterPointExtractor_<REJECTED>        }
