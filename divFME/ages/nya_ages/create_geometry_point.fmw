FACTORY_DEF {*} GeometryFilterFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { GeometryFilter_2 }    INPUT  FEATURE_TYPE FeatureReader_<OTHER>    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    FILTER_TYPES { Null }    INSTANCES { INSTANTIATE }    BREAK_AGG { Yes }    OUTPUT { <UNFILTERED> FEATURE_TYPE GeometryFilter_2_<UNFILTERED>  }    OUTPUT { Null FEATURE_TYPE GeometryFilter_2_Null  }
FACTORY_DEF * TeeFactory   FACTORY_NAME "GeometryFilter_2 Null Transformer Output Nuker"   INPUT FEATURE_TYPE GeometryFilter_2_Null
