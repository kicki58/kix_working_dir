#! START_HEADER
#! START_WB_HEADER
READER_TYPE MULTI_READER
MULTI_READER_TYPE{0} PATH
MULTI_READER_KEYWORD{0} PATH_1
MULTI_READER_GEN_DIRECTIVES{0} NO_EMPTY_PROPERTIES,YES,USE_NON_STRING_ATTR,yes,GLOB_PATTERN,*.xlsx,EXPOSE_ATTRS_GROUP,FME_DISCLOSURE_CLOSED,PATH_EXPOSE_FORMAT_ATTRS,,RECURSE_DIRECTORIES,NO,RETRIEVE_FILE_PROPERTIES,NO,HIDDEN_FILES,INCLUDE,_MERGE_SCHEMAS,YES,OFFSET_DATETIME,yes,TYPE,FILE,MODIFIED_AFTER,
MULTI_READER_TYPE{1} NULL
MULTI_READER_FORMAT{1} NULL
MULTI_READER_KEYWORD{1} OGCGEOPACKAGE_1
MULTI_READER_GEN_DIRECTIVES{1} SEARCH_ENVELOPE_MAXY,0,SPATIAL_GROUP,,SEARCH_ENVELOPE_MAXX,0,SEARCH_ENVELOPE_MINY,0,SEARCH_ENVELOPE_MINX,0,READ_NULLS,YES,ENCODE_FEATURE_TYPE_AND_ATTR_NAMES,YES,READ_BOOLEANS_AS_YES_NO,YES,EXPOSE_PRIMARY_KEY_ATTRIBUTE,YES,EXPOSE_ATTRS_GROUP,,COORDINATE_SYSTEM,,USE_SEARCH_ENVELOPE,NO,TABLELIST,,SEARCH_ENVELOPE_COORDINATE_SYSTEM,,CLIP_TO_ENVELOPE,NO,ENFORCE_FOREIGN_KEY_INTEGRITY,YES,OGCGEOPACKAGE_EXPOSE_FORMAT_ATTRS,,_MERGE_SCHEMAS,YES,ADVANCED_GROUP,,QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS,Yes,READER_REPLACE_INVALID_CHARS,NO,OPEN_SINGLE_RASTER_AS_SUBDATASET,YES
MULTI_READER_TYPE{2} OGCGEOPACKAGE
MULTI_READER_KEYWORD{2} OGCGEOPACKAGE_2
MULTI_READER_GEN_DIRECTIVES{2} OPEN_SINGLE_RASTER_AS_SUBDATASET,YES,SEARCH_ENVELOPE_COORDINATE_SYSTEM,,SEARCH_ENVELOPE_MINX,0,ADVANCED_GROUP,,EXPOSE_PRIMARY_KEY_ATTRIBUTE,YES,SEARCH_ENVELOPE_MINY,0,OGCGEOPACKAGE_EXPOSE_FORMAT_ATTRS,,READ_NULLS,YES,READ_BOOLEANS_AS_YES_NO,YES,ENFORCE_FOREIGN_KEY_INTEGRITY,YES,_MERGE_SCHEMAS,YES,ENCODE_FEATURE_TYPE_AND_ATTR_NAMES,YES,TABLELIST,,SEARCH_ENVELOPE_MAXY,0,READER_REPLACE_INVALID_CHARS,NO,EXPOSE_ATTRS_GROUP,,COORDINATE_SYSTEM,,USE_SEARCH_ENVELOPE,NO,SPATIAL_GROUP,,QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS,Yes,SEARCH_ENVELOPE_MAXX,0,CLIP_TO_ENVELOPE,NO
WRITER_TYPE MULTI_WRITER
WRITER_KEYWORD MULTI_DEST
MULTI_DEST_DATASET null
