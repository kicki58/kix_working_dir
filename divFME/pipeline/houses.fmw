FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   INPUT FEATURE_TYPE *    ROUTE PATH PATH_1::PATH multi_reader_keyword,$(DATASET_KEYWORD_PATH_1) TO FME_GENERIC ::PATH ALIAS_GEOMETRY    ROUTE CSV2 CSV2_1::CSV multi_reader_keyword,$(DATASET_KEYWORD_CSV2_1) TO FME_GENERIC ::CSV ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
PATH_1_MERGE_DEF PATH_1::PATH EXACT PATH
CSV2_1_MERGE_DEF CSV2_1::CSV EXACT CSV DEFLINE fme_attribute_reading,defined,document_id,varchar<openparen>12<closeparen>,filename,varchar<openparen>66<closeparen>,uppdragsnummer,uint32,ref_titel,varchar<openparen>248<closeparen>,namn,varchar<openparen>70<closeparen>,house_count,uint32,created_at,datetime,commisions,varchar<openparen>1<closeparen>,has_housing,varchar<openparen>4<closeparen>,has_artifact,varchar<openparen>5<closeparen>,has_landscape,varchar<openparen>5<closeparen>,has_environmental,varchar<openparen>5<closeparen>,has_graves_burials,varchar<openparen>5<closeparen>,primary_content_type,varchar<openparen>9<closeparen>
OGCGEOPACKAGE_1_MERGE_DEF OGCGEOPACKAGE_1::hus_point EXACT hus_point
OGCGEOPACKAGE_1_MERGE_DEF OGCGEOPACKAGE_1::layer_styles EXACT layer_styles
OGCGEOPACKAGE_1_MERGE_DEF OGCGEOPACKAGE_1::hus_polygon EXACT hus_polygon
OGCGEOPACKAGE_1_MERGE_DEF OGCGEOPACKAGE_1::hus_line EXACT hus_line
